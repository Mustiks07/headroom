# Copy to .env.local. Never commit credentials.
# The calculator, manual entry and local guest plans work without ANY of these.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional cloud save (invisible anonymous guest session, no login UI).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed for: AI quota store, demo/test entitlements, deleting the guest user on "Clear my data".
# Normal plan reads/writes never use it (they run as the guest with RLS).
SUPABASE_SECRET_KEY=

# Optional document analysis for PDF/images. Supported adapter: anthropic.
# Enabled only together with Supabase + SUPABASE_SECRET_KEY + migration 202611150003 (durable daily quota).
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Daily caps for the paid provider (defaults shown). Each call: <= 3 MB, <= 5 PDF pages, <= 4,000 output tokens, 40 s timeout.
AI_DAILY_LIMIT=100
AI_GUEST_DAILY_LIMIT=5
AI_IP_DAILY_LIMIT=15

# Optional Stripe TEST mode, never needed to enter the jury demo. Live (sk_live_) keys are ignored.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ANNUAL_PRICE_ID=
