# Copy to .env.local. Never commit credentials.
# The calculator, manual entry and local guest plans work without ANY of these.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional cloud save (invisible anonymous guest session, no login UI).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed for: AI quota store, demo/test entitlements, deleting the guest user on "Clear my data".
# Normal plan reads/writes never use it (they run as the guest with RLS).
SUPABASE_SECRET_KEY=

# Optional AI (see docs/AI_DEPLOYMENT.md). Providers: anthropic or basisweb. Off unless ALL of: provider, key,
# Supabase + SUPABASE_SECRET_KEY + migration 202611170005, a priced AI_MODEL and the feature listed in AI_FEATURES.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# extraction,proposal,explanation (unset = extraction only)
AI_FEATURES=
# Daily spend budgets in USD (global is the real ceiling; guests can be re-created).
AI_DAILY_BUDGET_USD=5
AI_GUEST_DAILY_BUDGET_USD=0.50
AI_IP_DAILY_BUDGET_USD=1
# BasisWeb uses the existing atomic call quota (migration 003), not Anthropic USD pricing.
# AI_MODEL for BasisWeb: claude-opus-5.5 (gateway model ids use a dot).
AI_DAILY_CALL_LIMIT=100
AI_GUEST_DAILY_CALL_LIMIT=10
AI_IP_DAILY_CALL_LIMIT=20

# Optional, server-only: official HealthCare.gov Marketplace API key for ZIP -> county candidates
# (GET /api/insurance/location?zip=). Only the ZIP is sent. Empty = ZIP lookup off; state + county
# name and the bundled CMS county extract keep working. Not tested with a real key yet.
MARKETPLACE_API_KEY=

# Optional Stripe TEST mode, never needed to enter the jury demo. Live (sk_live_) keys are ignored.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ANNUAL_PRICE_ID=
