# Copy to .env.local. Never commit credentials.
# The calculator, manual entry and local guest plans must work without these.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; normal user requests must still enforce ownership and RLS.
SUPABASE_SECRET_KEY=
# none until a provider is configured. No successful fake AI responses.
# Supported adapter: anthropic (AI_API_KEY = an Anthropic API key; AI_MODEL optional, default claude-opus-5-5).
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Optional Stripe TEST mode, never needed to enter the jury demo. Live (sk_live_) keys are ignored.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ANNUAL_PRICE_ID=
